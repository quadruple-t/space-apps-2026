# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/AGENTS.md
/out/

# production
/build

# Cesium runtime bundle, copied from node_modules by scripts/copy-cesium.mjs
/public/cesium/

# Horizons runtime cache written by the API route (prefetch/ and the test fixture are tracked)
/public/data/horizons/*.json
!/public/data/horizons/apollo11-sun.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
