NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server API routes use Firebase Admin. Prefer workload identity/ADC in hosted environments.
# For local use, set FIREBASE_SERVICE_ACCOUNT_JSON to the service account JSON as one line,
# or use Application Default Credentials (gcloud auth application-default login).
FIREBASE_PROJECT_ID=shadowline-2t12
# Full service-account JSON object (including client_email and private_key), not just the private key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set for Firebase Auth emulator ID token verification when running local API routes.
FIREBASE_AUTH_EMULATOR_HOST=
# "true" connects to the local auth (9099) and firestore (8080) emulators
NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=false
